<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy (Android 11 and lower) Auto Backup rules, defense in depth (SEC-1). Manifest sets allowBackup="false", so these are normally unused. Keep in sync with data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>